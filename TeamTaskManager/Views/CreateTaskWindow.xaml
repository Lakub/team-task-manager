<Window x:Class="TeamTaskManager.Views.CreateTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utwórz nowe zadanie" MinHeight="480" MinWidth="320" Height="600" Width="360"
        WindowStartupLocation="CenterScreen" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Utwórz zadanie" FontSize="28" FontWeight="Medium" Margin="0,-10,0,20" Foreground="#333"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Nazwa zadania *" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Height="40">
                <TextBox x:Name="TitleTextBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" FontSize="16"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                <TextBlock Text="Typ zadania *" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox x:Name="TaskTypeComboBox" Height="35" FontSize="14">
                    <ComboBoxItem IsSelected="True">Feature</ComboBoxItem>
                    <ComboBoxItem>Bug</ComboBoxItem>
                    <ComboBoxItem>Task</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Priorytet" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox x:Name="PriorityComboBox" Height="35" FontSize="14">
                    <ComboBoxItem>Low</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">Medium</ComboBoxItem>
                    <ComboBoxItem>High</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Przypisujący" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox x:Name="ReporterComboBox" Height="35" FontSize="14" Background="#4B5563">
                    <ComboBoxItem IsSelected="True">Jan Kowalski</ComboBoxItem>
                    <ComboBoxItem>Anna Nowak</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Przypisany" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox x:Name="AssigneeComboBox" Height="35" FontSize="14">
                    <ComboBoxItem IsSelected="True">Nieprzypisane</ComboBoxItem>
                    <ComboBoxItem>Jan Kowalski</ComboBoxItem>
                    <ComboBoxItem>Anna Nowak</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/> 
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Opis zadania" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="DescriptionTextBox" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="14" VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="3" Content="Anuluj" Width="100" Height="40" Margin="0,0,15,0" Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="14" FontWeight="Medium" Click="CancelButton_Click"/>

            <Button Grid.ColumnSpan="2" Height="40" BorderThickness="0" Background="{StaticResource DefaultButtonBackground}" Foreground="White" Click="CreateButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Utwórz" FontSize="14" FontWeight="SemiBold"/>
            </Button>
        </Grid>
    </Grid>
</Window>