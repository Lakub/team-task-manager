<UserControl x:Class="TeamTaskManager.Views.HeadAdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TeamTaskManager.Views.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Badge style for task status -->
        <Style x:Key="StatusBadgeBorder" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8 0"/>
            <Setter Property="Padding" Value="8 3"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Nagłówek ── -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="18 14" Margin="0 0 0 10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="5" CornerRadius="3" Background="#4B5563" Margin="0 0 14 0"/>
                <StackPanel>
                    <TextBlock Text="Panel HeadAdmin" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="Przegląd statystyk systemu i zarządzanie użytkownikami"
                               FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 3 0 0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">

            <!-- Brak dostępu -->
            <Border Background="#FEE2E2" CornerRadius="10" Padding="20"
                    Visibility="{Binding AccessDenied, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding AccessMessage}" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>

                    <!-- ════════════════════════════════════════════════════════════ -->
                    <!-- WIDOK: STATYSTYKI                                           -->
                    <!-- ════════════════════════════════════════════════════════════ -->
                    <StackPanel Visibility="{Binding ShowStats, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- ── Wiersz 1: główne karty ── -->
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Użytkownicy -->
                            <Button Grid.Column="0" Command="{Binding ShowUsersCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="10" ClipToBounds="True" MinHeight="90">
                                            <Grid><Border Width="5" HorizontalAlignment="Left" Background="#3B82F6"/>
                                                <StackPanel Margin="18 14 12 14">
                                                    <TextBlock Text="{Binding UsersCount}" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/>
                                                    <TextBlock Text="Użytkownicy" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 3 0 0"/>
                                                    <TextBlock Text="Zarządzaj →" FontFamily="Segoe UI" FontSize="10" Foreground="#3B82F6" Margin="0 5 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#EFF6FF"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Projekty -->
                            <Button Grid.Column="2" Command="{Binding ShowProjectsCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="10" ClipToBounds="True" MinHeight="90">
                                            <Grid><Border Width="5" HorizontalAlignment="Left" Background="#8B5CF6"/>
                                                <StackPanel Margin="18 14 12 14">
                                                    <TextBlock Text="{Binding ProjectsCount}" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/>
                                                    <TextBlock Text="Projekty" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 3 0 0"/>
                                                    <TextBlock Text="Podgląd →" FontFamily="Segoe UI" FontSize="10" Foreground="#8B5CF6" Margin="0 5 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#F5F3FF"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Taski -->
                            <Button Grid.Column="4" Command="{Binding ShowTasksCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="10" ClipToBounds="True" MinHeight="90">
                                            <Grid><Border Width="5" HorizontalAlignment="Left" Background="#F59E0B"/>
                                                <StackPanel Margin="18 14 12 14">
                                                    <TextBlock Text="{Binding TasksCount}" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/>
                                                    <TextBlock Text="Taski" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 3 0 0"/>
                                                    <TextBlock Text="Podgląd →" FontFamily="Segoe UI" FontSize="10" Foreground="#F59E0B" Margin="0 5 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#FFFBEB"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Sprinty -->
                            <Button Grid.Column="6" Command="{Binding ShowSprintsCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="10" ClipToBounds="True" MinHeight="90">
                                            <Grid><Border Width="5" HorizontalAlignment="Left" Background="#10B981"/>
                                                <StackPanel Margin="18 14 12 14">
                                                    <TextBlock Text="{Binding SprintsCount}" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/>
                                                    <TextBlock Text="Sprinty" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 3 0 0"/>
                                                    <TextBlock Text="Podgląd →" FontFamily="Segoe UI" FontSize="10" Foreground="#10B981" Margin="0 5 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#ECFDF5"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ── Wiersz 2: drugorzędne karty ── -->
                        <Grid Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Komentarze -->
                            <Button Grid.Column="0" Command="{Binding ShowCommentsCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="8" ClipToBounds="True" MinHeight="72">
                                            <Grid><Border Width="4" HorizontalAlignment="Left" Background="#6B7280"/>
                                                <StackPanel Margin="14 10 10 10">
                                                    <TextBlock Text="{Binding CommentsCount}" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#374151"/>
                                                    <TextBlock Text="Komentarze" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 2 0 0"/>
                                                    <TextBlock Text="Podgląd →" FontFamily="Segoe UI" FontSize="10" Foreground="#6B7280" Margin="0 4 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#F9FAFB"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Worklogi -->
                            <Button Grid.Column="2" Command="{Binding ShowWorklogsCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="8" ClipToBounds="True" MinHeight="72">
                                            <Grid><Border Width="4" HorizontalAlignment="Left" Background="#14B8A6"/>
                                                <StackPanel Margin="14 10 10 10">
                                                    <TextBlock Text="{Binding WorklogsCount}" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#374151"/>
                                                    <TextBlock Text="Worklogi" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 2 0 0"/>
                                                    <TextBlock Text="Podgląd →" FontFamily="Segoe UI" FontSize="10" Foreground="#14B8A6" Margin="0 4 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#F0FDFA"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Załączniki -->
                            <Button Grid.Column="4" Command="{Binding ShowAttachmentsCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="8" ClipToBounds="True" MinHeight="72">
                                            <Grid><Border Width="4" HorizontalAlignment="Left" Background="#EC4899"/>
                                                <StackPanel Margin="14 10 10 10">
                                                    <TextBlock Text="{Binding AttachmentsCount}" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#374151"/>
                                                    <TextBlock Text="Załączniki" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 2 0 0"/>
                                                    <TextBlock Text="Podgląd →" FontFamily="Segoe UI" FontSize="10" Foreground="#EC4899" Margin="0 4 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#FDF2F8"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Dokumentacja -->
                            <Button Grid.Column="6" Command="{Binding ShowDocsCommand}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="c" Background="White" CornerRadius="8" ClipToBounds="True" MinHeight="72">
                                            <Grid><Border Width="4" HorizontalAlignment="Left" Background="#6366F1"/>
                                                <StackPanel Margin="14 10 10 10">
                                                    <TextBlock Text="{Binding DocumentationCount}" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#374151"/>
                                                    <TextBlock Text="Dokumentacja" FontFamily="Segoe UI" FontSize="11" Foreground="#9CA3AF" Margin="0 2 0 0"/>
                                                    <TextBlock Text="Podgląd →" FontFamily="Segoe UI" FontSize="10" Foreground="#6366F1" Margin="0 4 0 0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="#EEF2FF"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ── Wiersz 3: wykresy kołowe ── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20 16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                                        <Border Width="4" CornerRadius="2" Background="#F59E0B" Margin="0 0 10 0"/>
                                        <TextBlock Text="Taski wg statusu" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <controls:PieChartControl Slices="{Binding TaskSlices}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20 16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                                        <Border Width="4" CornerRadius="2" Background="#3B82F6" Margin="0 0 10 0"/>
                                        <TextBlock Text="Sprinty wg statusu" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <controls:PieChartControl Slices="{Binding SprintSlices}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>

                    <!-- ════════════════════════════════════════════════════════════ -->
                    <!-- HELPER: back nav bar (used by all detail panels)           -->
                    <!-- ════════════════════════════════════════════════════════════ -->

                    <!-- ── PANEL: UŻYTKOWNICY ── -->
                    <StackPanel Visibility="{Binding ShowUserListPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="White" CornerRadius="10" Padding="14 10" Margin="0 0 0 10">
                            <DockPanel>
                                <Button Content="← Wróć" Command="{Binding BackToStatsCommand}" DockPanel.Dock="Left"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="#3B82F6" FontFamily="Segoe UI" FontSize="13" Padding="0"/>
                                <Button x:Name="AddUserButton" Content="+ Dodaj użytkownika" DockPanel.Dock="Right"
                                        Cursor="Hand" Background="#4B5563" Foreground="White"
                                        BorderThickness="0" Padding="14 6" FontFamily="Segoe UI" FontSize="13"
                                        Click="AddUserButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btn" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="btn" Property="Background" Value="#374151"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="Użytkownicy" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1F2937" VerticalAlignment="Center" Margin="16 0 0 0"/>
                            </DockPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="#F9FAFB" CornerRadius="10 10 0 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/><ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="230"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Imię i nazwisko" Padding="16 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="Email"            Padding="10 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="2" Text="Rola"             Padding="10 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="3" Text="Ost. logowanie"  Padding="10 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="4" Text="Akcje"            Padding="10 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding UserList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0 1 0 0">
                                                <Grid MinHeight="44">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/><ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="230"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FullName}" Foreground="#1F2937" FontWeight="SemiBold" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" Padding="16 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Email}"    Foreground="#6B7280" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="10 0" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="10 0" Padding="8 3" CornerRadius="12">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RoleLabel}" Value="Admin"><Setter Property="Background" Value="#EFF6FF"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding RoleLabel}" Value="HeadAdmin"><Setter Property="Background" Value="#F5F3FF"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding RoleLabel}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RoleLabel}" Value="Admin"><Setter Property="Foreground" Value="#3B82F6"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding RoleLabel}" Value="HeadAdmin"><Setter Property="Foreground" Value="#7C3AED"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding LastLogin}" Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Padding="10 0" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8 0">
                                                        <Button Content="Ustaw Admin" Command="{Binding PromoteCommand}"
                                                                Visibility="{Binding CanPromote, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="#EFF6FF" Foreground="#3B82F6" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                                BorderThickness="0" Padding="10 5" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#DBEAFE"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Content="Cofnij do User" Command="{Binding DemoteCommand}"
                                                                Visibility="{Binding CanDemote, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="#FEF2F2" Foreground="#EF4444" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                                BorderThickness="0" Padding="10 5" Cursor="Hand" Margin="4 0 0 0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FEE2E2"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Content="Usuń konto" Command="{Binding DeleteCommand}"
                                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="#FEF2F2" Foreground="#DC2626" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                                BorderThickness="0" Padding="10 5" Cursor="Hand" Margin="4 0 0 0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FEE2E2"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── PANEL: PROJEKTY ── -->
                    <StackPanel Visibility="{Binding ShowProjectsPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="White" CornerRadius="10" Padding="14 10" Margin="0 0 0 10">
                            <DockPanel>
                                <Button Content="← Wróć" Command="{Binding BackToStatsCommand}" DockPanel.Dock="Left"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="#3B82F6" FontFamily="Segoe UI" FontSize="13" Padding="0"/>
                                <TextBlock FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"
                                           VerticalAlignment="Center" Margin="16 0 0 0">
                                    <Run Text="Projekty"/><Run Text=" · " Foreground="#9CA3AF"/>
                                    <Run Text="{Binding ProjectsCount}" Foreground="#9CA3AF" FontSize="13" FontWeight="Normal"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="#F9FAFB" CornerRadius="10 10 0 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="150"/><ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="70"/><ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Nazwa"      Padding="16 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="Klucz"      Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="2" Text="Właściciel" Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="3" Text="Członkowie" Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="4" Text="Taski"      Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="5" Text="Utworzono"  Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding ProjectList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0 1 0 0">
                                                <Grid MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="70"/>
