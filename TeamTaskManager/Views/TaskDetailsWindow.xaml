<UserControl x:Class="TeamTaskManager.Views.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeamTaskManager.Views"
        mc:Ignorable="d"
        Height="700" Width="450" Background="White"
        >

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="{Binding Title, FallbackValue='Nazwa zadania'}" 
                       FontSize="36" 
                       FontWeight="Normal" 
                       Margin="0,0,0,25" 
                       TextWrapping="Wrap"/>

            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Przypisany:" VerticalAlignment="Center" Margin="0,0,15,15" FontSize="14"/>
                <Border Grid.Row="0" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Assignee.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Przypisujący:" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Row="1" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Reporter.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#555" BorderThickness="1" CornerRadius="8" MinHeight="250" Margin="0,0,0,25">
                <TextBox Text="{Binding Description, FallbackValue='Opis zadania'}" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         BorderThickness="0" 
                         Background="Transparent" 
                         Margin="15" 
                         FontSize="14" 
                         Foreground="Gray"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>

            <Border Grid.Row="3" Background="#DFDFDF" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="24" Height="24" Fill="#C0C0C0" Margin="0,0,10,0"/>
                        <TextBlock Text="Użytkownik" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" 
                             Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged, FallbackValue='Dodaj komentarz...'}" 
                             Foreground="Gray" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             FontSize="14"
                             AcceptsReturn="True"
                             MinHeight="40"
                             Margin="0,0,0,10"/>

                    <Button Grid.Row="2" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand" Background="White" Foreground="Black">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="25,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Wstaw" FontSize="14" FontWeight="Medium"/>
                    </Button>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="4" ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#DFDFDF" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="24" Height="24" Fill="#C0C0C0" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Author.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Content, FallbackValue='Komentarz itp.'}" TextWrapping="Wrap" Foreground="Black" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</UserControl>
