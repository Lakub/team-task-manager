<UserControl x:Class="TeamTaskManager.Views.TaskDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:TeamTaskManager.Helpers"
        mc:Ignorable="d" d:Width="800" d:Height="600"
        Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding TaskKey}" FontFamily="Segoe UI" FontSize="14" Foreground="#6B7280" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="{Binding TypeBadgeBg}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeDisplay}" FontFamily="Segoe UI" FontSize="11" Foreground="{Binding TypeBadgeFg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold" Foreground="#1F2937" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding PopOutCommand}"
                            Visibility="{Binding IsPoppedOut, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            ToolTip="Otwórz w osobnym oknie" Padding="6,4" Width="32" Height="28">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding EditTaskCommand}"
                            Visibility="{Binding CanManageProject, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Edytuj zadanie" Padding="6,4" Width="32" Height="28" Margin="4,0,0,0">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>

                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding DeleteTaskCommand}"
                            Visibility="{Binding CanManageProject, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Usuń zadanie" Padding="6,4" Width="32" Height="28" Margin="4,0,0,0">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="210" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="OPIS" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border MaxHeight="{Binding MaxTextHeight}" ClipToBounds="True">
                                    <TextBlock x:Name="DescriptionText" Text="{Binding Description}" FontFamily="Segoe UI" FontSize="14"
                                               Foreground="#374151" TextWrapping="Wrap" LineHeight="22"/>
                                </Border>
                                <Button Style="{StaticResource InlineSeeMoreButtonStyle}" Content="{Binding ToggleTextLabel}"
                                        Command="{Binding ToggleTextCommand}" HorizontalAlignment="Right" FontSize="13"
                                        Visibility="{Binding TextOverflows, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBlock Text="Brak opisu." FontStyle="Italic" Foreground="#9CA3AF" 
                                       Visibility="{Binding HasNoDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="DZIENNIK PRACY" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Button Content="+ Dodaj wpis" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right"
                                        Command="{Binding LogWorkCommand}" VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Worklogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <!-- autor, czas zaczecia, edytuj, usun -->
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding AvatarBg}" CornerRadius="9"
                                                            Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initials}" FontFamily="Segoe UI" FontSize="8"
                                                                   FontWeight="SemiBold" Foreground="{Binding AvatarFg}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="#374151" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StartedAtStr}" Foreground="#9CA3AF"
                                                               ToolTip="{Binding DateToolTipStr}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Button Style="{StaticResource IconActionButtonStyle}" CommandParameter="{Binding}" ToolTip="Edytuj"
                                                                Command="{Binding DataContext.EditWorklogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#9CA3AF"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconActionButtonStyle}" CommandParameter="{Binding}" ToolTip="Usuń"
                                                                Command="{Binding DataContext.DeleteWorklogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#9CA3AF"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border MaxHeight="{Binding MaxTextHeight}" ClipToBounds="True">
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#4B5563" LineHeight="20"
                                                                       Loaded="ItemText_Loaded" SizeChanged="ItemText_SizeChanged"/>
                                                    </Border>
                                                    <Button Style="{StaticResource InlineSeeMoreButtonStyle}" Content="{Binding ToggleTextLabel}"
                                                                Command="{Binding ToggleTextCommand}" HorizontalAlignment="Right" FontSize="11"
                                                                Visibility="{Binding TextOverflows, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="6" Margin="10,0,0,0" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeSpentStr}" Foreground="#374151" FontWeight="SemiBold" FontSize="13"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Brak wpisów." FontStyle="Italic" Foreground="#9CA3AF" Margin="0,10,0,0"
                                       Visibility="{Binding Worklogs, Converter={StaticResource InverseCollectionToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="KOMENTARZE" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>

                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                                <Grid Margin="0,5,0,0">
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,10,30,10">
                                        <TextBox Text="{Binding NewCommentContent, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#374151" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" helpers:FocusHelper.IsFocused="{Binding FocusCommentInput}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddCommentCommand}" CommandParameter="{Binding}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                        <Button Style="{StaticResource ActionButtonStyle}" Padding="5,3" CommandParameter="{Binding}" ToolTip="Dodaj komentarz"
                                            Command="{Binding AddCommentCommand}">
                                            <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Padding="0,15,0,5" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <!-- autor, data stworzenia, edytowane, edytuj, usun -->
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding AvatarBg}" CornerRadius="9"
                                                            Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initials}" FontFamily="Segoe UI" FontSize="8"
                                                                   FontWeight="SemiBold" Foreground="{Binding AvatarFg}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               Foreground="#374151" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CreatedAtStr}" Foreground="#9CA3AF"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding EditInformation}" Foreground="#9CA3AF"
                                                               VerticalAlignment="Center" ToolTip="{Binding UpdatedAtStr}" FontStyle="Italic"
                                                               Visibility="{Binding WasEdited, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                    <StackPanel Orientation="Horizontal" Grid.Column="5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Button Style="{StaticResource IconActionButtonStyle}" CommandParameter="{Binding}" ToolTip="Edytuj"
                                                                Command="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconActionButtonStyle}" CommandParameter="{Binding}" ToolTip="Usuń"
                                                                Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- tresc -->
                                                <StackPanel Visibility="{Binding IsDeleted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                    <!-- faktyczna tresc -->
                                                    <StackPanel Visibility="{Binding IsBeingEdited, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <Border MaxHeight="{Binding MaxTextHeight}" ClipToBounds="True">
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#4B5563" LineHeight="20"
                                                                   Loaded="ItemText_Loaded" SizeChanged="ItemText_SizeChanged"/>
                                                        </Border>
                                                        <Button Style="{StaticResource InlineSeeMoreButtonStyle}" Content="{Binding ToggleTextLabel}"
                                                            Command="{Binding ToggleTextCommand}" HorizontalAlignment="Right" FontSize="11"
                                                            Visibility="{Binding TextOverflows, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <!-- edytowanie -->
                                                    <Grid Visibility="{Binding IsBeingEdited, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,10,55,10">
                                                            <TextBox Text="{Binding DataContext.EditCommentContent, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#374151" TextWrapping="Wrap" AcceptsReturn="True"
                                                                     VerticalScrollBarVisibility="Auto" helpers:FocusHelper.IsFocused="{Binding IsBeingEdited}">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Modifiers="Control" CommandParameter="{Binding}"
                                                                                Command="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                    <KeyBinding Key="Escape" CommandParameter="{Binding}"
                                                                                Command="{Binding DataContext.CancelEditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                                            <Button Style="{StaticResource ActionButtonStyle}" Margin="0,0,4,0" Padding="5,3" CommandParameter="{Binding}" ToolTip="Anuluj"
                                                                    Command="{Binding DataContext.CancelEditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                                                            </Button>
                                                            <Button Style="{StaticResource ActionButtonStyle}" Padding="5,3" CommandParameter="{Binding}" ToolTip="Zapisz zmiany"
                                                                    Command="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                            
                                                <!-- usuniety -->
                                                <TextBlock Margin="0,0,0,15"
                                                           Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Text="[ Ten komentarz został usunięty ]" FontStyle="Italic" Foreground="#6B7280"/>

                                                <!-- odpowiadanie -->
                                                <Grid Margin="0,5,0,0" Visibility="{Binding IsDeleted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,10,55,10"
                                                            Visibility="{Binding IsBeingRepliedTo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBox Text="{Binding DataContext.NewReplyContent, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#374151" TextWrapping="Wrap" AcceptsReturn="True"
                                                                 VerticalScrollBarVisibility="Auto" helpers:FocusHelper.IsFocused="{Binding IsBeingRepliedTo}">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Modifiers="Control" CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.AddReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                <KeyBinding Key="Escape" CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.CancelReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                                        <Button Style="{StaticResource ActionButtonStyle}" Margin="0,0,4,0" Padding="5,3" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.CancelReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                ToolTip="Anuluj" Visibility="{Binding IsBeingRepliedTo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                                                        </Button>

                                                        <Button Style="{StaticResource ActionButtonStyle}" Padding="5,3" CommandParameter="{Binding}" ToolTip="Dodaj odpowiedź"
                                                                Command="{Binding DataContext.AddReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- odpowiedzi -->
                                                <ItemsControl ItemsSource="{Binding Replies}" Margin="30,5,0,0"
                                                              Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,10,0,5">
                                                                <StackPanel>
                                                                    <!-- autor, data stworzenia, edytowane, edytuj, usun -->
                                                                    <Grid Margin="0,0,0,5">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Background="{Binding AvatarBg}" CornerRadius="9"
                                                                                Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Initials}" FontFamily="Segoe UI" FontSize="8"
                                                                                       FontWeight="SemiBold" Foreground="{Binding AvatarFg}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                                   Foreground="#374151" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding CreatedAtStr}" Foreground="#9CA3AF"
                                                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding EditInformation}" Foreground="#9CA3AF"
                                                                                   VerticalAlignment="Center" ToolTip="{Binding UpdatedAtStr}" FontStyle="Italic"
                                                                                   Visibility="{Binding WasEdited, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                                        <StackPanel Orientation="Horizontal" Grid.Column="5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Button Style="{StaticResource IconActionButtonStyle}" CommandParameter="{Binding}" ToolTip="Edytuj"
                                                                                    Command="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                                            </Button>
                                                                            <Button Style="{StaticResource IconActionButtonStyle}" CommandParameter="{Binding}" ToolTip="Usuń"
                                                                                    Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- tresc -->
                                                                    <StackPanel Visibility="{Binding IsDeleted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                        <!-- faktyczna tresc -->
                                                                        <StackPanel Visibility="{Binding IsBeingEdited, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                            <Border MaxHeight="{Binding MaxTextHeight}" ClipToBounds="True">
                                                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#4B5563" LineHeight="20"
                                                                                           Loaded="ItemText_Loaded" SizeChanged="ItemText_SizeChanged"/>
                                                                            </Border>
                                                                            <Button Style="{StaticResource InlineSeeMoreButtonStyle}" Content="{Binding ToggleTextLabel}"
                                                                                    Command="{Binding ToggleTextCommand}" HorizontalAlignment="Right" FontSize="11"
                                                                                    Visibility="{Binding TextOverflows, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        </StackPanel>

                                                                        <!-- edytowanie -->
                                                                        <Grid Visibility="{Binding IsBeingEdited, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,10,55,10">
                                                                                <TextBox Text="{Binding DataContext.EditCommentContent, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#374151" TextWrapping="Wrap" AcceptsReturn="True"
                                                                                         VerticalScrollBarVisibility="Auto" helpers:FocusHelper.IsFocused="{Binding IsBeingEdited}">
                                                                                    <TextBox.InputBindings>
                                                                                        <KeyBinding Key="Enter" Modifiers="Control" CommandParameter="{Binding}"
                                                                                                    Command="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                                        <KeyBinding Key="Escape" CommandParameter="{Binding}"
                                                                                                    Command="{Binding DataContext.CancelEditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                                    </TextBox.InputBindings>
                                                                                </TextBox>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                                                                <Button Style="{StaticResource ActionButtonStyle}" Margin="0,0,4,0" Padding="5,3" CommandParameter="{Binding}" ToolTip="Anuluj"
                                                                                        Command="{Binding DataContext.CancelEditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                                    <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                                                                                </Button>
                                                                                <Button Style="{StaticResource ActionButtonStyle}" Padding="5,3" CommandParameter="{Binding}" ToolTip="Zapisz zmiany"
                                                                                        Command="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </StackPanel>

                                                                    <!-- usuniety -->
                                                                    <TextBlock Margin="0,0,0,15"
                                                                               Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                               Text="[ Ten komentarz został usunięty ]" FontStyle="Italic" Foreground="#6B7280"/>

                                                                    <!-- odpowiadanie -->
                                                                    <Grid Margin="0,5,0,0" Visibility="{Binding IsDeleted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,10,55,10"
                                                                            Visibility="{Binding IsBeingRepliedTo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBox Text="{Binding DataContext.NewReplyContent, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#374151" TextWrapping="Wrap" AcceptsReturn="True"
                                                                                 VerticalScrollBarVisibility="Auto" helpers:FocusHelper.IsFocused="{Binding IsBeingRepliedTo}">
                                                                                <TextBox.InputBindings>
                                                                                    <KeyBinding Key="Enter" Modifiers="Control" CommandParameter="{Binding}"
                                                                                                Command="{Binding DataContext.AddReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                                    <KeyBinding Key="Escape" CommandParameter="{Binding}"
                                                                                                Command="{Binding DataContext.CancelReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                                </TextBox.InputBindings>
                                                                            </TextBox>
                                                                        </Border>

                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                                                            <Button Style="{StaticResource ActionButtonStyle}" Margin="0,0,4,0" Padding="5,3" CommandParameter="{Binding}"
                                                                                Command="{Binding DataContext.CancelReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                ToolTip="Anuluj" Visibility="{Binding IsBeingRepliedTo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                                                                            </Button>

                                                                            <Button Style="{StaticResource ActionButtonStyle}" Padding="5,3" CommandParameter="{Binding}" ToolTip="Dodaj odpowiedź"
                                                                                Command="{Binding DataContext.AddReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                                <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Brak komentarzy." FontStyle="Italic" Foreground="#9CA3AF" Margin="0,10,0,0"
                                       Visibility="{Binding HasNoComments, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          Background="#F3F4F6" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                                       Text="SZCZEGÓŁY" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding SelectedStatus}"            
                                          Visibility="{Binding CanManageProject, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12"
                                          DisplayMemberPath="DisplayName" Width="90" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Priorytet:" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PriorityDisplay}" Foreground="{Binding PriorityColor}"
                                           FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sprint:" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SprintName}" FontWeight="Medium"
                                           VerticalAlignment="Center" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Czas pracy:" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalTimeSpent}" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Margin="0,25,0,15" Background="#E5E7EB"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Utworzono:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAtStr}" Foreground="#9CA3AF"
                                           VerticalAlignment="Center" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Zmieniono:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedAtStr}" Foreground="#9CA3AF"
                                           VerticalAlignment="Center" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OSOBY" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                            <TextBlock Text="Przypisane do" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Background="{Binding AssigneeAvatarBg}" CornerRadius="15" Width="30" Height="30" HorizontalAlignment="Left" Margin="0,0,10,0"
                                        Visibility="{Binding IsUnassigned, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AssigneeInitials}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                Foreground="{Binding AssigneeAvatarFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="{Binding AssigneeName}" Foreground="#1F2937" VerticalAlignment="Center" FontWeight="Medium"
                                            Visibility="{Binding CanManageProject, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <ComboBox ItemsSource="{Binding ProjectUsers}" SelectedItem="{Binding SelectedAssignee}"
                                            Visibility="{Binding CanManageProject, Converter={StaticResource BoolToVisibilityConverter}}"
                                            DisplayMemberPath="FullName" MinWidth="120" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Zgłaszający" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Background="{Binding ReporterAvatarBg}" CornerRadius="15" Width="30" Height="30" HorizontalAlignment="Left" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ReporterInitials}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                           Foreground="{Binding ReporterAvatarFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding ReporterName}" Foreground="#1F2937" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>