<Window x:Class="TeamTaskManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Okno główne" Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8"
                Padding="12 0" Margin="0 0 8 8">
            <TextBlock Text="Sprint X, od: do" Foreground="#6B7280"
                    FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="#D1D5DB" CornerRadius="8"
                Padding="12 0" HorizontalAlignment="Right" Width="160" Margin="0 0 0 8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="28" Height="28" Fill="#9CA3AF" Margin="0 0 8 0"/>
                <TextBlock Text="Użytkownik" Foreground="#1F2937"
                            FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0 0 8 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0 0 0 8">
                <Border Background="White" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                    <StackPanel>
                        <TextBlock Text="Projekt" Foreground="#9CA3AF" FontSize="10" FontFamily="Segoe UI" Margin="0 0 0 4"/>
                        <ComboBox Background="White" Foreground="#1F2937"
                                BorderBrush="#D1D5DB" BorderThickness="1"
                                FontFamily="Segoe UI" FontSize="13" Height="30">
                            <ComboBoxItem Content="TeamTaskManager" IsSelected="True"/>
                            <ComboBoxItem Content="Projekt B"/>
                            <ComboBoxItem Content="Projekt C"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Button Content="Archiwalne Sprinty" Style="{StaticResource NavButton}" Margin="0 0 0 6"/>
                <Button Content="Członkowie zespołu" Style="{StaticResource NavButton}" Margin="0 0 0 6"/>
                <Button Content="Stwórz nowy Sprint" Style="{StaticResource NavButton}" Margin="0 0 0 6"/>
                <Button Style="{StaticResource NavButton}" Margin="0 0 0 6"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="90" Height="90" Stroke="#D1D5DB" StrokeThickness="10"
                            Fill="Transparent" HorizontalAlignment="Center"/>
                    <TextBlock Text="Graf kołowy wykonanych zadań aktualnego sprintu"
                            Foreground="#6B7280" FontFamily="Segoe UI" FontSize="11"
                            TextWrapping="Wrap" TextAlignment="Center" Margin="0 12 0 0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="0 0 8 0">
                <StackPanel>
                    <TextBlock Text="To Do" Foreground="#4B5563" FontFamily="Segoe UI"
                            FontSize="13" FontWeight="SemiBold" Margin="0 0 0 10"/>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 1" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 2" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 3" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 4" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="0 0 8 0">
                <StackPanel>
                    <TextBlock Text="W trakcie" Foreground="#4B5563" FontFamily="Segoe UI"
                            FontSize="13" FontWeight="SemiBold" Margin="0 0 0 10"/>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 5" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 6" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 7" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Zrobione" Foreground="#4B5563" FontFamily="Segoe UI"
                            FontSize="13" FontWeight="SemiBold" Margin="0 0 0 10"/>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 8" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 9" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="10 8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="#D1D5DB" Margin="0 0 8 0"/>
                            <TextBlock Text="Zadanie 10" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>