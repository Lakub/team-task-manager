                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FEE2E2"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── PANEL: WORKLOGI ── -->
                    <StackPanel Visibility="{Binding ShowWorklogsPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="White" CornerRadius="10" Padding="14 10" Margin="0 0 0 10">
                            <DockPanel>
                                <Button Content="← Wróć" Command="{Binding BackToStatsCommand}" DockPanel.Dock="Left"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="#3B82F6" FontFamily="Segoe UI" FontSize="13" Padding="0"/>
                                <TextBlock FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"
                                           VerticalAlignment="Center" Margin="16 0 0 0">
                                    <Run Text="Worklogi"/><Run Text=" · " Foreground="#9CA3AF"/>
                                    <Run Text="{Binding WorklogsCount}" Foreground="#9CA3AF" FontSize="13" FontWeight="Normal"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="#F9FAFB" CornerRadius="10 10 0 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Użytkownik"   Padding="16 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="Task"          Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="2" Text="Czas spędzony" Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="3" Text="Zalogowano"    Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="4" Text="Akcje"         Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding WorklogList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0 1 0 0">
                                                <Grid MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding UserName}"  Foreground="#1F2937" FontWeight="SemiBold" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="16 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TaskTitle}" Foreground="#6B7280" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="8 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeSpent}" Foreground="#14B8A6" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Padding="8 0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding LoggedAt}"  Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="8 0"/>
                                                    <Button Grid.Column="4" Content="Usuń" Command="{Binding DeleteCommand}"
                                                            Background="#FEF2F2" Foreground="#DC2626" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                            BorderThickness="0" Padding="8 5" Cursor="Hand" VerticalAlignment="Center" Margin="4 0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FEE2E2"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── PANEL: ZAŁĄCZNIKI ── -->
                    <StackPanel Visibility="{Binding ShowAttachmentsPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="White" CornerRadius="10" Padding="14 10" Margin="0 0 0 10">
                            <DockPanel>
                                <Button Content="← Wróć" Command="{Binding BackToStatsCommand}" DockPanel.Dock="Left"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="#3B82F6" FontFamily="Segoe UI" FontSize="13" Padding="0"/>
                                <TextBlock FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"
                                           VerticalAlignment="Center" Margin="16 0 0 0">
                                    <Run Text="Załączniki"/><Run Text=" · " Foreground="#9CA3AF"/>
                                    <Run Text="{Binding AttachmentsCount}" Foreground="#9CA3AF" FontSize="13" FontWeight="Normal"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="#F9FAFB" CornerRadius="10 10 0 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="150"/><ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Plik"       Padding="16 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="Task"       Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="2" Text="Dodał"      Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="3" Text="Data"       Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding AttachmentList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0 1 0 0">
                                                <Grid MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="150"/><ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"     Foreground="#1F2937" FontWeight="SemiBold" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="16 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TaskTitle}"    Foreground="#6B7280" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="8 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UploaderName}" Foreground="#374151" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="8 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding UploadedAt}"   Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="8 0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── PANEL: DOKUMENTACJA ── -->
                    <StackPanel Visibility="{Binding ShowDocsPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="White" CornerRadius="10" Padding="14 10" Margin="0 0 0 10">
                            <DockPanel>
                                <Button Content="← Wróć" Command="{Binding BackToStatsCommand}" DockPanel.Dock="Left"
                                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="#3B82F6" FontFamily="Segoe UI" FontSize="13" Padding="0"/>
                                <TextBlock FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"
                                           VerticalAlignment="Center" Margin="16 0 0 0">
                                    <Run Text="Dokumentacja"/><Run Text=" · " Foreground="#9CA3AF"/>
                                    <Run Text="{Binding DocumentationCount}" Foreground="#9CA3AF" FontSize="13" FontWeight="Normal"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="#F9FAFB" CornerRadius="10 10 0 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tytuł"       Padding="16 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="Projekt"     Padding="8 10"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="2" Text="Aktualizacja" Padding="8 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding DocList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0 1 0 0">
                                                <Grid MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="130"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}"       Foreground="#1F2937" FontWeight="SemiBold" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" Padding="16 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectName}" Foreground="#6B7280" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="8 0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UpdatedAt}"   Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Padding="8 0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
