<UserControl x:Class="TeamTaskManager.Views.WikiMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6" Height="600" Width="960">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Baza wiedzy" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,15"/>

                <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Height="35" Margin="0,0,0,15">
                    <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Foreground="#1F2937" Text="Szukaj w dokumentacji..."/>
                </Border>

                <TreeView Grid.Row="2" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#4B5563">
                    <TreeViewItem Header="Architektura" IsExpanded="True">
                        <TreeViewItem Header="Baza danych"/>
                        <TreeViewItem Header="Autoryzacja"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Wymagania projektu" IsExpanded="True">
                        <TreeViewItem Header="Funkcjonalne" FontWeight="SemiBold" Foreground="#0052CC"/>
                        <TreeViewItem Header="Niefunkcjonalne"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Notatki ze spotkań"/>
                </TreeView>

                <Button Grid.Row="3" Content="+ Nowa strona" Height="40" Background="{StaticResource DefaultButtonBackground}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0" Click="NewArticleButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Wymagania Funkcjonalne" FontSize="28" FontWeight="Medium" Foreground="#1F2937" TextWrapping="Wrap"/>

                    <Button Grid.Column="1" Content="Edytuj" Width="80" Height="35" Background="#E5E7EB" Foreground="#1F2937" BorderThickness="0" Cursor="Hand" Click="EditArticleButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,25">
                    <TextBlock Text="Ostatnia edycja:" Foreground="#9CA3AF" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock Text="Jan Kowalski" Foreground="#6B7280" FontSize="12" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    <TextBlock Text="24.05.2024 14:30" Foreground="#9CA3AF" FontSize="12"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="Tutaj znajduje się treść dokumentacji. Można tutaj zaimplementować bibliotekę wspierającą Markdown (np. Markdig), aby tekst był ładnie formatowany: posiadał nagłówki, listy wypunktowane i pogrubienia. Na ten moment jest to zwykły TextBlock pozwalający na zawijanie wierszy." 
                               FontSize="14" Foreground="#333" TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>