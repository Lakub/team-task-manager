<UserControl x:Class="TeamTaskManager.Views.AllTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F3F4F6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Wszystkie zadania" FontFamily="Segoe UI" FontSize="13"
                               FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding FilterOptions}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding SelectedFilter, Mode=TwoWay}"
                                  FontFamily="Segoe UI" FontSize="12"
                                  Padding="8,4" Margin="0,0,6,0"
                                  VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding ToggleSortCommand}"
                                ToolTip="Zmień kierunek sortowania"
                                Width="34" Height="30" Padding="4">
                            <TextBlock Text="{Binding SortArrow}" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectTaskCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NonRoundedListItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                        <Binding Path="TaskId"/>
                                                        <Binding Path="DataContext.SelectedTaskId"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="#EBF0FC"
                                                                    BorderBrush="#C7D7F8"
                                                                    BorderThickness="3,0,0,0"
                                                                    Padding="9,10">
                                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="#DDE8FA"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding StatusColor}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Key}" FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <Border Background="{Binding TypeBadgeBg}" CornerRadius="8" Padding="5,2">
                                            <TextBlock Text="{Binding TypeDisplay}" FontFamily="Segoe UI" FontSize="10"
                                                       Foreground="{Binding TypeBadgeFg}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI" HorizontalAlignment="Left"
                                               Foreground="#1F2937" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <TextBlock Grid.Row="1" Text="Nie znaleziono zadań spełniających kryteria." FontFamily="Segoe UI" FontSize="12" 
                    Visibility="{Binding FilteredTasks, Converter={StaticResource InverseCollectionToVisibilityConverter}}"
                    Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,10"
                    Visibility="{Binding CanManageProject, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="+ Utwórz zadanie" Margin="0,4,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CreateTaskCommand}">
                </Button>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      Background="#E5E7EB" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2">
            <Border Background="White" Visibility="{Binding HasSelectedTask, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               Foreground="#D1D5DB" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding NoTaskSelectedFeedback}" FontFamily="Segoe UI" FontSize="14"
                               Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <local:TaskDetailsView x:Name="TaskDetailPanel" DataContext="{x:Null}"
                Visibility="{Binding DataContext.HasSelectedTask, RelativeSource={RelativeSource AncestorType=UserControl},
                Converter={StaticResource BoolToVisibilityConverter}}"
                xmlns:local="clr-namespace:TeamTaskManager.Views"/>
        </Grid>
    </Grid>
</UserControl>
