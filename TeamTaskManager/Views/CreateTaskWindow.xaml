<Window x:Class="TeamTaskManager.Views.CreateTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:TeamTaskManager.Models.Enums"
        Title="Utwórz nowe zadanie" MinHeight="480" MinWidth="320" Height="600" Width="360"
        WindowStartupLocation="CenterScreen" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Utwórz zadanie" FontSize="28" FontWeight="Medium" Margin="0,-10,0,20" Foreground="#333"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Nazwa zadania *" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Height="40">
                <TextBox x:Name="TitleTextBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" FontSize="16"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,0,15">
                <TextBlock Text="Typ zadania *" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox x:Name="TaskTypeComboBox" Height="35" FontSize="14" ItemsSource="{Binding TaskTypes}" SelectedItem="{Binding SelectedType}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Priorytet" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox x:Name="PriorityComboBox" Height="35" FontSize="14" ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Grid.Column="2">
            <TextBlock Text="Przypisany" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <ComboBox x:Name="AssigneeComboBox" Height="35" FontSize="14" ItemsSource="{Binding ProjectMembers}" SelectedItem="{Binding SelectedAssignee}" DisplayMemberPath="FullName"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Opis zadania" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="DescriptionTextBox" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="14"
                         VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>
        </Grid>
        
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CreateCommand}"
                    IsEnabled="{Binding IsValid}"
                    Grid.Column="0"
                    >
                <TextBlock Text="Utwórz" FontSize="14" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Grid.Column="1">
                <TextBlock Text="Anuluj" FontSize="14" FontWeight="SemiBold"/>
            </Button>
        </Grid>
    </Grid>
</Window>