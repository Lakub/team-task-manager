<UserControl x:Class="TeamTaskManager.Views.HeadAdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="8" Padding="20" Margin="0 0 0 12">
            <StackPanel>
                <TextBlock Text="Panel HeadAdmin" FontSize="24" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="Globalny podgląd danych systemowych i przygotowanie pod funkcje administracyjne."
                           Margin="0 8 0 0" Foreground="#6B7280" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Border Background="#FEE2E2"
                    CornerRadius="8"
                    Padding="20"
                    Visibility="{Binding AccessDenied, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding AccessMessage}" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibilityConverter}}">
                <UniformGrid Columns="2" Rows="4">
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 12 12"><StackPanel><TextBlock Text="Użytkownicy" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding UsersCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 0 12"><StackPanel><TextBlock Text="Projekty" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding ProjectsCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 12 12"><StackPanel><TextBlock Text="Taski" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding TasksCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 0 12"><StackPanel><TextBlock Text="Sprinty" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding SprintsCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 12 12"><StackPanel><TextBlock Text="Komentarze" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding CommentsCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 0 12"><StackPanel><TextBlock Text="Worklogi" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding WorklogsCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 12 12"><StackPanel><TextBlock Text="Załączniki" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding AttachmentsCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0 0 0 12"><StackPanel><TextBlock Text="Dokumentacja" Foreground="#6B7280" FontSize="12"/><TextBlock Text="{Binding DocumentationCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/><TextBlock Text="Na razie panel raportuje dostępność modułu dokumentacji." Margin="0 8 0 0" Foreground="#9CA3AF" TextWrapping="Wrap"/></StackPanel></Border>
                </UniformGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
