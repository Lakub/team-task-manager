<Window x:Class="TeamTaskManager.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja" Height="580" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">

    <StackPanel VerticalAlignment="Center" Margin="48 0">

        <Border Width="56" Height="56" CornerRadius="14" Background="#4B5563"
                HorizontalAlignment="Center" Margin="0 0 0 12">
            <TextBlock Text="TT" FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="TeamTaskManager" FontSize="20" FontWeight="Bold"
                   Foreground="#1F2937" HorizontalAlignment="Center"/>
        <TextBlock Text="Utwórz konto użytkownika" FontSize="12"
                   Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0 4 0 32"/>

        <TextBlock Text="Imię i nazwisko" Foreground="#6B7280" FontSize="12" Margin="0 0 0 6"/>
        <TextBox Height="44" Margin="0 0 0 16"
                 Background="White" Foreground="#1F2937"
                 BorderBrush="#D1D5DB" BorderThickness="1" Padding="12 10"
                 x:Name="FullNameBox"/>

        <TextBlock Text="Email" Foreground="#6B7280" FontSize="12" Margin="0 0 0 6"/>
        <TextBox Height="44" Margin="0 0 0 16"
                 Background="White" Foreground="#1F2937"
                 BorderBrush="#D1D5DB" BorderThickness="1" Padding="12 10"
                 x:Name="EmailBox"/>

        <TextBlock Text="Hasło" Foreground="#6B7280" FontSize="12" Margin="0 0 0 6"/>
        <PasswordBox Height="44" Margin="0 0 0 16"
                     Background="White" Foreground="#1F2937"
                     BorderBrush="#D1D5DB" BorderThickness="1" Padding="12 10"
                     x:Name="PasswordBox"/>

        <TextBlock Text="Rola" Foreground="#6B7280" FontSize="12" Margin="0 0 0 6"/>
        <ComboBox Height="44" Margin="0 0 0 28"
                  Background="White" Foreground="#1F2937"
                  BorderBrush="#D1D5DB" BorderThickness="1" Padding="10 0"
                  x:Name="RoleComboBox" SelectedIndex="0">
            <ComboBoxItem Content="User"/>
            <ComboBoxItem Content="Admin"/>
        </ComboBox>

        <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12"
                   TextWrapping="Wrap" Margin="0 0 0 12" Visibility="Collapsed"/>

        <Button Content="UTWÓRZ KONTO" Height="46" Margin="0 0 0 12"
                Background="{StaticResource DefaultButtonBackground}" Foreground="White"
                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                Click="RegisterButton_Click"/>

        <Button Content="Anuluj" Height="46"
                Background="White" Foreground="#4B5563"
                FontWeight="SemiBold" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"
                Click="BackToLoginButton_Click"/>

    </StackPanel>
</Window>
