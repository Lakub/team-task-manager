<UserControl x:Class="TeamTaskManager.Views.SprintReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:TeamTaskManager.Helpers"
             mc:Ignorable="d"
        Background="#F3F4F6">

    <UserControl.Resources>
        <local:IntToStarGridLengthConverter x:Key="StarConverter" />
        
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonActive" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical">

            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding SprintName, FallbackValue='Sprint'}"
                                        FontFamily="Segoe UI" FontSize="18" FontWeight="Medium"
                                        Foreground="#1F2937" Margin="0,0,10,0"/>

                            <Border Background="#D1FAE5" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText, FallbackValue='W toku'}" FontFamily="Segoe UI" FontSize="12"
                                            FontWeight="Medium" Foreground="#065F46"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="PROJEKT" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding ProjectName, FallbackValue='Projekt'}" FontFamily="Segoe UI" FontSize="13" Foreground="#374151"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="START" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding StartDateStr, FallbackValue='01.01.2026'}" FontFamily="Segoe UI" FontSize="13" Foreground="#374151"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="KONIEC" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding EndDateStr, FallbackValue='01.01.2026'}" FontFamily="Segoe UI" FontSize="13" Foreground="#374151"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="AUTOR" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="18" Height="18" Fill="#D1D5DB" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding CreatorName, FallbackValue='Autor Sprintu'}" FontFamily="Segoe UI" FontSize="13" Foreground="#374151"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="14,8" Visibility="{Binding IsActive}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DaysRemaining, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="28" FontWeight="Medium"
                                            Foreground="#92400E" HorizontalAlignment="Center"/>
                                <TextBlock Text="dni pozostało" FontFamily="Segoe UI" FontSize="11"
                                            Foreground="#B45309" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Postęp sprintu" FontFamily="Segoe UI" FontSize="13"
                                    FontWeight="Medium" Foreground="#374151" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ProgressText, FallbackValue='0 / 1 zadań ukończonych (0%)'}" FontFamily="Segoe UI"
                                    FontSize="13" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Background="#E5E7EB" CornerRadius="5" Height="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DoneTasks, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}" />
                                <ColumnDefinition Width="{Binding RemainingTasks, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                Background="#10B981" 
                                CornerRadius="5" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="UKOŃCZONE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding DoneTasks, FallbackValue='0'}" Style="{StaticResource MetricValue}" Foreground="#065F46"/>
                        <TextBlock Text="{Binding TotalTasks, StringFormat='z {0} zadań', FallbackValue='z 1 zadań'}" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ŚR. CZAS ZADANIA" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding AvgTaskTime, FallbackValue='0.0h'}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="NAJDŁUŻSZE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding LongestTaskTime, FallbackValue='0.0h'}" Style="{StaticResource MetricValue}" Foreground="#B45309"/>
                        <TextBlock Text="{Binding LongestTaskName, FallbackValue='Nazwa zadania'}" Style="{StaticResource MetricLabel}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SCOPE CREEP" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ScopeCreepCount, FallbackValue='0'}" Style="{StaticResource MetricValue}" Foreground="#B45309"/>
                        <TextBlock Text="zadania po starcie" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="W TRAKCIE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding InProgressTasks, FallbackValue='0'}" Style="{StaticResource MetricValue}" Foreground="#1D4ED8"/>
                        <TextBlock Text="zadania" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="DO ZROBIENIA" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding TodoTasks, FallbackValue='0'}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="zadania" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="DESCOPED" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding DescoppedTasks, FallbackValue='0'}" Style="{StaticResource MetricValue}" Foreground="#B91C1C"/>
                        <TextBlock Text="usunięte ze sprintu" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="BEZ PRZYPISANIA" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding UnassignedTasks, FallbackValue='0'}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="zadanie" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ROZKŁAD TYPÓW" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Margin="0,0,0,8">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Feature" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="6,0">
                                    <Border Background="#EFF6FF" CornerRadius="4" Height="8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding FeatureCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}"/>
                                            <ColumnDefinition Width="{Binding NonFeatureCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#3B82F6" CornerRadius="4" Height="8"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding FeatureCount, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bug" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="6,0">
                                    <Border Background="#FEF2F2" CornerRadius="4" Height="8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding BugCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}"/>
                                            <ColumnDefinition Width="{Binding NonBugCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#EF4444" CornerRadius="4" Height="8"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding BugCount, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Task" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="6,0">
                                    <Border Background="#F5F3FF" CornerRadius="4" Height="8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding TaskCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}"/>
                                            <ColumnDefinition Width="{Binding NonTaskCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#8B5CF6" CornerRadius="4" Height="8"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding TaskCount, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ROZKŁAD PRIORYTETÓW" Style="{StaticResource SectionTitle}"/>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="High" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="6,0">
                                    <Border Background="#FEF2F2" CornerRadius="4" Height="8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding HighPrioCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}"/>
                                            <ColumnDefinition Width="{Binding NonHighPrioCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#EF4444" CornerRadius="4" Height="8"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding HighPrioCount, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Medium" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="6,0">
                                    <Border Background="#FFFBEB" CornerRadius="4" Height="8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding MediumPrioCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}"/>
                                            <ColumnDefinition Width="{Binding NonMediumPrioCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#F59E0B" CornerRadius="4" Height="8"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding MediumPrioCount, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Low" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="6,0">
                                    <Border Background="#F0FDF4" CornerRadius="4" Height="8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding LowPrioCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}"/>
                                            <ColumnDefinition Width="{Binding NonLowPrioCount, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#22C55E" CornerRadius="4" Height="8"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding LowPrioCount, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="ZADANIA SPRINTU" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FilterButtonActive}" Content="Wszystkie" Margin="0,0,4,0" Command="{Binding FilterCommand}" CommandParameter="{x:Null}"/>
                            <Button Style="{StaticResource FilterButton}" Content="Ukończone" Margin="0,0,4,0" Command="{Binding FilterCommand}" CommandParameter="done"/>
                            <Button Style="{StaticResource FilterButton}" Content="W trakcie" Margin="0,0,4,0" Command="{Binding FilterCommand}" CommandParameter="inprogress"/>
                            <Button Style="{StaticResource FilterButton}" Content="Scope zmiany" Command="{Binding FilterCommand}" CommandParameter="scope"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Zadanie" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="2" Text="Typ" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="3" Text="Priorytet" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                        <TextBlock Grid.Column="4" Text="Czas" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl x:Name="TaskListControl" ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding StatusColor}"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontFamily="Segoe UI" FontSize="13" Foreground="#1F2937" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{Binding ScopeBadgeBg}" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" Visibility="{Binding ScopeBadgeVisibility}">
                                                <TextBlock Text="{Binding ScopeBadgeText}" FontFamily="Segoe UI" FontSize="11" Foreground="{Binding ScopeBadgeFg}"/>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{Binding TypeBadgeBg}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeDisplay}" FontFamily="Segoe UI" FontSize="11" Foreground="{Binding TypeBadgeFg}"/>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding PriorityDisplay}" FontFamily="Segoe UI" FontSize="12" Foreground="{Binding PriorityColor}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4" Text="{Binding TimeSpent}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="ZAANGAŻOWANIE ZESPOŁU" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding TeamMembers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{Binding AvatarBg}" CornerRadius="18" Width="30" Height="30" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Initials}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AvatarFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding FullName}" FontFamily="Segoe UI" FontSize="13" Foreground="#1F2937" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding DoneCount, StringFormat='{}{0} ukończone'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Ellipse Width="8" Height="8" Fill="#60A5FA" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding InProgressCount, StringFormat='{}{0} w toku'}" FontFamily="Segoe UI" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="5" Text="{Binding HoursLogged, StringFormat='{}{0}h'}" FontFamily="Segoe UI" FontSize="13" FontWeight="Medium" Foreground="#374151" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>