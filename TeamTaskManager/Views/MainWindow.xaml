<Window x:Class="TeamTaskManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Okno główne" Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DefaultButtonBackground}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TempNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#ffcccc"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8"
                    Padding="12 0" Margin="0 0 8 8">
                <TextBlock Text="Sprint X, od: do" Foreground="#6B7280"
                        FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="1">
                <Border Background="White" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                    <StackPanel>
                        <TextBlock Text="Projekt" Foreground="#9CA3AF" FontSize="10" FontFamily="Segoe UI" Margin="0 0 0 4"/>
                        <ComboBox Background="White" Foreground="#1F2937"
                                BorderBrush="#D1D5DB" BorderThickness="1"
                                FontFamily="Segoe UI" FontSize="13" Height="30">
                            <ComboBoxItem Content="TeamTaskManager" IsSelected="True"/>
                            <ComboBoxItem Content="Projekt B"/>
                            <ComboBoxItem Content="Projekt C"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Button Content="Aktualny Sprint" Style="{StaticResource NavButton}" Command="{Binding ShowCurrentSprintCommand}"/>
                <Button Content="Wszystkie Sprinty" Style="{StaticResource NavButton}" Command="{Binding ShowAllSprintsCommand}"/>
                <Button Content="Członkowie zespołu" Style="{StaticResource NavButton}" Command="{Binding ShowTeamMembersCommand}"/>
                <Button Content="Stwórz nowy Sprint" Style="{StaticResource NavButton}" Command="{Binding CreateNewSprintCommand}"/>
                <Button Content="Sprint raport" Style="{StaticResource NavButton}" Command="{Binding ShowSprintReportCommand}"/>
                <Button Content="TEMP rand seed db" Style="{StaticResource TempNavButton}" Command="{Binding RandomSeedDbCommand}"/>
                <Button Content="TEMP reset db" Style="{StaticResource TempNavButton}" Command="{Binding ClearDbCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#D1D5DB" CornerRadius="8"
                    Padding="12 0" HorizontalAlignment="Right" Width="Auto" Margin="0 0 0 8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="28" Height="28" Fill="#9CA3AF" Margin="0 0 8 0"/>
                    <TextBlock Text="{Binding CurrentUserName}" Foreground="#1F2937"
                            FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="8 0 0 0">
                <ContentControl x:Name="MainContent"
                            Grid.Row="1"
                            Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>