<UserControl x:Class="TeamTaskManager.Views.CurrentSprintView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F3F4F6">

    <Grid Margin="8 0 0 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="0 0 8 0">
            <StackPanel>
                <TextBlock Text="To Do" Foreground="{StaticResource DefaultButtonBackground}"
                            FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Margin="0 0 0 10"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="10" Margin="0 0 8 0">
            <StackPanel>
                <TextBlock Text="W trakcie" Foreground="{StaticResource DefaultButtonBackground}"
                            FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Margin="0 0 0 10"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="10">
            <StackPanel>
                <TextBlock Text="Zrobione" Foreground="{StaticResource DefaultButtonBackground}"
                            FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Margin="0 0 0 10"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>