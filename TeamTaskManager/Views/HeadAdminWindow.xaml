<Window x:Class="TeamTaskManager.Views.HeadAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TeamTaskManager.Views"
        Title="Panel HeadAdmin" Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D1D5DB" CornerRadius="8"
                Padding="12 0" HorizontalAlignment="Right" Width="Auto" Margin="0 0 0 8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="28" Height="28" Fill="#9CA3AF" Margin="0 0 8 0"/>
                <TextBlock x:Name="UserNameText" Foreground="#1F2937"
                           FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
                <Button Content="X" Click="LogoutButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#1F2937" Cursor="Hand" Margin="8 0 0 0"/>
            </StackPanel>
        </Border>

        <local:HeadAdminPanelView Grid.Row="1"/>
    </Grid>
</Window>
