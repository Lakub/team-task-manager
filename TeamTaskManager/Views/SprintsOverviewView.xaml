<UserControl x:Class="TeamTaskManager.Views.SprintsOverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:TeamTaskManager.Helpers"
        mc:Ignorable="d"
        Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="SprintCardStyle" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1.0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                    <Setter Property="Background" Value="#F5F8FF"/>
                    <Setter Property="Opacity" Value="0.85"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="StartSprintButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EndSprintButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sprints}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SprintCardStyle}" Margin="0,0,0,8" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.OpenSprintReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding SprintName, FallbackValue='Sprint'}"
                                                    FontFamily="Segoe UI" FontSize="18" FontWeight="Medium"
                                                    Foreground="#1F2937" Margin="0,0,10,0"/>

                                        <Border Background="{Binding StatusBg}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText, FallbackValue='W toku'}" Foreground="{Binding StatusFg}"
                                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="START" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding StartDateStr, FallbackValue='01.01.2026'}" FontFamily="Segoe UI" FontSize="13" Foreground="#374151"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="KONIEC" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding EndDateStr, FallbackValue='01.01.2026'}" FontFamily="Segoe UI" FontSize="13" Foreground="#374151"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="AUTOR" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding CreatorAvatarBg}" CornerRadius="9" Width="18" Height="18" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding CreatorInitials}" FontFamily="Segoe UI" FontSize="8"
                                                               FontWeight="SemiBold" Foreground="{Binding CreatorAvatarFg}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatorName, FallbackValue='Autor Sprintu'}" FontFamily="Segoe UI" FontSize="13" Foreground="#374151"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Background="#FEF3C7" CornerRadius="8" Padding="14,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DaysRemaining, FallbackValue='0'}" FontFamily="Segoe UI" FontSize="28" FontWeight="Medium"
                                                        Foreground="#92400E" HorizontalAlignment="Center"/>
                                            <TextBlock Text="dni do końca" FontFamily="Segoe UI" FontSize="11"
                                                        Foreground="#B45309" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom">
                                    <Border Background="#E5E7EB" CornerRadius="5" Height="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding DoneTasks, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=0}" />
                                                <ColumnDefinition Width="{Binding RemainingTasks, Converter={StaticResource StarConverter}, Mode=OneWay, FallbackValue=1}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#10B981" CornerRadius="5" />
                                        </Grid>
                                    </Border>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ProgressText, FallbackValue='0 / 1 zadań ukończonych (0%)'}" FontFamily="Segoe UI"
                                                    FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <Button Content="▶  Rozpocznij sprint" Style="{StaticResource StartSprintButtonStyle}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.StartSprintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                                                <Binding Path="IsPlanned"/>
                                                <Binding Path="DataContext.CanManageProject" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>

                                    <Button Content="■  Zakończ sprint" Style="{StaticResource EndSprintButtonStyle}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.EndSprintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                                                <Binding Path="IsActive"/>
                                                <Binding Path="DataContext.CanManageProject" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,40"
                    Visibility="{Binding HasSprints, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                       Foreground="#D1D5DB" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="Brak sprintów w tym projekcie" FontFamily="Segoe UI" FontSize="15" 
                       Foreground="#9CA3AF" HorizontalAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="1" Content="+ Utwórz nowy sprint" Margin="0,8,0,0"
                Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateSprintCommand}"
                Visibility="{Binding CanManageProject, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>