<Window x:Class="TeamTaskManager.Views.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeamTaskManager.Views"
        mc:Ignorable="d"
        Title="CreateProjectWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Utwórz projekt" FontSize="28" FontWeight="Medium" Margin="0,-10,0,20" Foreground="#333"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Nazwa projektu" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Height="40">
                <TextBox x:Name="TitleTextBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" FontSize="16"/>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Dodaj użytkownika" FontSize="14" Foreground="Gray" Margin="0,0,15,5"></TextBlock>
            <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,15,15,15">
                <ComboBoxItem IsSelected="True">Użytkownik</ComboBoxItem>
                <ComboBoxItem>Użytkownik</ComboBoxItem>
                <ComboBoxItem>Użytkownik</ComboBoxItem>
                <ComboBoxItem>Użytkownik</ComboBoxItem>
            </ComboBox>
            
            <TextBlock Grid.Column="1" Grid.Row="0" Text="Przypisani" FontSize="14" Foreground="Gray" Margin="0,0,0,0"/>
            <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Visible" Padding="5">
            <StackPanel Orientation="Horizontal" CanHorizontallyScroll="True">
                <Border Grid.Row="0" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Assignee.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Assignee.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Assignee.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Assignee.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Assignee.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#D9D9D9" CornerRadius="15" Height="30" HorizontalAlignment="Left" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Fill="White" Margin="3,0,10,0"/>
                        <TextBlock Text="{Binding Assignee.FullName, FallbackValue='Użytkownik'}" VerticalAlignment="Center" Foreground="#555" FontSize="14" Margin="0,0,15,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Opis projektu" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="DescriptionTextBox" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="14" VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Anuluj" Width="100" Height="40" Margin="0,0,15,0" Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="14" FontWeight="Medium" Click="CancelButton_Click"/>

            <Button Grid.Column="0" Height="40" BorderThickness="0" Background="{StaticResource DefaultButtonBackground}" Foreground="White" Click="CreateButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Utwórz" FontSize="14" FontWeight="SemiBold"/>
            </Button>
        </Grid>
    </Grid>
</Window>
