<UserControl x:Class="TeamTaskManager.Views.Controls.PieChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Canvas x:Name="PieCanvas" Width="130" Height="130" HorizontalAlignment="Center"/>
        <ItemsControl x:Name="Legend" Margin="0 10 0 0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="8 3">
                        <Ellipse Width="9" Height="9" Fill="{Binding Color}"
                                 VerticalAlignment="Center" Margin="0 0 5 0"/>
                        <TextBlock FontSize="11" Foreground="#6B7280" VerticalAlignment="Center">
                            <Run Text="{Binding Label, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Value, StringFormat=' {0:0}', Mode=OneWay}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#374151"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
