<Window x:Class="TeamTaskManager.Views.CreateWorklogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TeamTaskManager.Views"
        Title="{Binding WindowTitle}" MinHeight="480" MinWidth="320" Height="600" Width="360"
        WindowStartupLocation="CenterScreen" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="28" FontWeight="Medium" Margin="0,-10,0,20" Foreground="#333"/>

        <views:WorklogFormView Grid.Row="1"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsValid}"
                    Grid.Column="0">
                <TextBlock Text="Utwórz" FontSize="14" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Grid.Column="1">
                <TextBlock Text="Anuluj" FontSize="14" FontWeight="SemiBold"/>
            </Button>
        </Grid>
    </Grid>
</Window>