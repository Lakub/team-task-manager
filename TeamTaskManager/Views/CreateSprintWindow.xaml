<Window x:Class="TeamTaskManager.Views.CreateSprintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utwórz nowy sprint" MinHeight="400" MinWidth="320" Height="480" Width="360"
        WindowStartupLocation="CenterScreen" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Utwórz sprint" FontSize="28" FontWeight="Medium" Margin="0,-10,0,20" Foreground="#333"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,25">
            <TextBlock Text="Nazwa sprintu *" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Height="40">
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Background="Transparent"
                         BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" FontSize="16"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Data rozpoczęcia" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Height="40">
                <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            Validation.ErrorTemplate="{StaticResource SilentErrorTemplate}" Background="Transparent"
                            BorderThickness="0" VerticalContentAlignment="Center" FontSize="16" Padding="5,0"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,6">
            <TextBlock Text="Data zakończenia" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Height="40">
                <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Background="Transparent" BorderThickness="0"
                            VerticalContentAlignment="Center" FontSize="16" Padding="5,0"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding CollisionWarning}" Foreground="#D97706" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,14"
                   Visibility="{Binding HasCollisionWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CreateCommand}"
                    IsEnabled="{Binding IsValid}"
                    Grid.Column="0">
                <TextBlock Text="Utwórz" FontSize="14" FontWeight="SemiBold"/>
            </Button>

            <Button Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Grid.Column="1">
                <TextBlock Text="Anuluj" FontSize="14" FontWeight="SemiBold"/>
            </Button>
        </Grid>
    </Grid>
</Window>