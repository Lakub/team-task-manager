<Window x:Class="TeamTaskManager.Views.CreateSprintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy Sprint" Height="420" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">

    <StackPanel VerticalAlignment="Center" Margin="48 0">

        <TextBlock Text="Nowy Sprint" FontSize="20" FontWeight="Bold"
                    Foreground="#1F2937" HorizontalAlignment="Center"/>
        <TextBlock Text="Wypełnij dane nowego sprintu" FontSize="12"
                    Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0 4 0 20"/>

        <TextBlock Text="Nazwa sprintu" Foreground="#6B7280" FontSize="12" Margin="0 0 0 6"/>
        <TextBox Height="44" Margin="0 0 0 12"
                Background="White" Foreground="#1F2937"
                BorderBrush="#D1D5DB" BorderThickness="1" Padding="12 10"/>

        <TextBlock Text="Data rozpoczęcia" Foreground="#6B7280" FontSize="12" Margin="0 0 0 6"/>
        <DatePicker Height="44" Margin="0 0 0 12"
                    Background="White" Foreground="#1F2937"
                    BorderBrush="#D1D5DB" BorderThickness="1" Padding="12 10"/>

        <TextBlock Text="Data zakończenia" Foreground="#6B7280" FontSize="12" Margin="0 0 0 6"/>
        <DatePicker Height="44" Margin="0 0 0 20"
                    Background="White" Foreground="#1F2937"
                    BorderBrush="#D1D5DB" BorderThickness="1" Padding="12 10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="ANULUJ" Height="46"
                    Background="#F3F4F6" Foreground="#4B5563"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

            <Button Grid.Column="2" Content="UTWÓRZ" Height="46"
                    Background="#4B5563" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </Grid>

    </StackPanel>
</Window>